rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    // An admin is any signed-in user who has a document at admins/{their uid}.
    // Create that document by hand in the Firebase console; the app cannot write it.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The signed-in student's own profile
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function validPhone(p) {
      return p is string && p.matches('^01[0125][0-9]{8}$');
    }

    // The app checks for three names; here we only check length
    function validName(n) {
      return n is string && n.size() >= 5 && n.size() <= 60;
    }

    function validLink(l) {
      return l is string && l.size() <= 300 && (l == '' || l.matches('https?://.+'));
    }

    // ---------- team helpers ----------
    function teamDoc(cid, tid) {
      return get(/databases/$(database)/documents/competitions/$(cid)/teams/$(tid)).data;
    }
    function teamAfter(cid, tid) {
      return getAfter(/databases/$(database)/documents/competitions/$(cid)/teams/$(tid)).data;
    }
    function teamExists(cid, tid) {
      return exists(/databases/$(database)/documents/competitions/$(cid)/teams/$(tid));
    }

    // ---------- admins ----------
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- student accounts ----------
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['studentId', 'fullName', 'phone', 'school', 'createdAt'])
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() >= 3
        && request.resource.data.studentId.size() <= 30
        && request.auth.token.email == request.resource.data.studentId + '@stem-collab.app'
        && validName(request.resource.data.fullName)
        && validPhone(request.resource.data.phone)
        && request.resource.data.school is string
        && request.resource.data.school.size() <= 80
        && request.resource.data.createdAt == request.time;

      // Student: change the phone number, or set the full name once
      // (only for accounts that were created before names existed)
      allow update: if request.auth != null
        && request.auth.uid == uid
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone'])
            && validPhone(request.resource.data.phone))
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName'])
            && !('fullName' in resource.data)
            && validName(request.resource.data.fullName))
        );

      // Admin: name, phone and school
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'school'])
        && validName(request.resource.data.fullName)
        && validPhone(request.resource.data.phone)
        && request.resource.data.school is string
        && request.resource.data.school.size() <= 80;

      allow delete: if isAdmin();
    }

    // ---------- announcements (posted by admins, read by everyone signed in) ----------
    match /announcements/{id} {
      allow read: if request.auth != null;

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'body', 'link', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 1000
        && validLink(request.resource.data.link)
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- competitions (posted by admins, read by everyone signed in) ----------
    function validComp(d) {
      return d.keys().hasOnly(['title', 'description', 'categories', 'date', 'time', 'location', 'link', 'cover', 'imageCount', 'mode', 'minTeam', 'maxTeam', 'createdAt'])
        && d.keys().hasAll(['title', 'description', 'categories', 'date', 'time', 'location', 'link', 'cover', 'imageCount'])
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 120
        && d.description is string && d.description.size() <= 5000
        && d.categories is list && d.categories.size() >= 1 && d.categories.size() <= 8
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && (d.time == '' || d.time.matches('^[0-2][0-9]:[0-5][0-9]$'))
        && d.location is string && d.location.size() <= 150
        && validLink(d.link)
        && d.cover is string && d.cover.size() <= 150000
        && d.imageCount is int && d.imageCount >= 0 && d.imageCount <= 12
        // participation: older competitions have no 'mode' and count as individual
        && (!('mode' in d)
            || (d.mode == 'individual')
            || (d.mode == 'team'
                && d.minTeam is int && d.maxTeam is int
                && d.minTeam >= 1 && d.maxTeam >= d.minTeam && d.maxTeam <= 20));
    }

    match /competitions/{id} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        && validComp(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && validComp(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();

      // Full-size photos (compressed JPEG data URLs), one document per photo
      match /images/{imgId} {
        allow read: if request.auth != null;
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['data', 'order'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 600000
          && request.resource.data.order is int;
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['order'])
          && request.resource.data.order is int;
        allow delete: if isAdmin();
      }

      // ---------- teams (only for competitions whose mode is 'team') ----------

      // One membership document per student per competition: it makes "one team only" a hard rule.
      // It is always written in the same batch as the team change that justifies it.
      match /members/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['teamId'])
          && request.resource.data.teamId is string
          && (
            // the student creating their own team
            (request.auth.uid == uid
              && teamAfter(id, request.resource.data.teamId).ownerUid == uid
              && teamAfter(id, request.resource.data.teamId).memberIds == [uid])
            // the team owner accepting a student
            || (teamDoc(id, request.resource.data.teamId).ownerUid == request.auth.uid
              && uid in teamAfter(id, request.resource.data.teamId).memberIds)
          );

        allow update: if false;

        allow delete: if request.auth != null
          && (isAdmin()
            || !teamExists(id, resource.data.teamId)
            || teamDoc(id, resource.data.teamId).ownerUid == request.auth.uid
            || (request.auth.uid == uid && !(uid in teamAfter(id, resource.data.teamId).memberIds)));
      }

      match /teams/{tid} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && get(/databases/$(database)/documents/competitions/$(id)).data.get('mode', 'individual') == 'team'
          && request.resource.data.keys().hasOnly(['name', 'description', 'photo', 'ownerUid', 'ownerName', 'max', 'memberIds', 'members', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 3
          && request.resource.data.name.size() <= 50
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.photo is string
          && request.resource.data.photo.size() <= 150000
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerName == me().fullName
          && request.resource.data.max == get(/databases/$(database)/documents/competitions/$(id)).data.maxTeam
          && request.resource.data.memberIds == [request.auth.uid]
          && request.resource.data.members is list
          && request.resource.data.members.size() == 1
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/competitions/$(id)/members/$(request.auth.uid)).data.teamId == tid;

        // Only the member lists change after creation.
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
          && request.resource.data.members.size() == request.resource.data.memberIds.size()
          && (
            // the owner accepts one student who sent a pending request, while the team still has room
            (resource.data.ownerUid == request.auth.uid
              && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
              && request.resource.data.memberIds.size() <= resource.data.max
              && request.resource.data.memberIds.hasAll(resource.data.memberIds)
              && get(/databases/$(database)/documents/competitions/$(id)/teams/$(tid)/requests/$(request.resource.data.memberIds.removeAll(resource.data.memberIds)[0])).data.status == 'pending')
            // a member leaves, or the owner removes a member (the owner can never be removed)
            || (request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
              && resource.data.memberIds.hasAll(request.resource.data.memberIds)
              && resource.data.ownerUid in request.resource.data.memberIds
              && (resource.data.ownerUid == request.auth.uid
                  || resource.data.memberIds.removeAll(request.resource.data.memberIds)[0] == request.auth.uid))
          );

        allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());

        // Join requests: the document id is the applicant's uid.
        // Only the applicant and the team owner (and admins) can read one: it holds a phone number.
        match /requests/{uid} {
          allow read: if request.auth != null
            && (request.auth.uid == uid || teamDoc(id, tid).ownerUid == request.auth.uid || isAdmin());

          allow create: if request.auth != null
            && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['uid', 'name', 'studentId', 'school', 'phone', 'reason', 'status', 'createdAt'])
            && request.resource.data.uid == uid
            && request.resource.data.name == me().fullName
            && request.resource.data.studentId == me().studentId
            && request.resource.data.school == me().school
            && request.resource.data.phone == me().phone
            && request.resource.data.reason is string
            && request.resource.data.reason.size() >= 5
            && request.resource.data.reason.size() <= 500
            && request.resource.data.status == 'pending'
            && request.resource.data.createdAt == request.time
            && !(uid in teamDoc(id, tid).memberIds)
            && teamDoc(id, tid).memberIds.size() < teamDoc(id, tid).max
            && !exists(/databases/$(database)/documents/competitions/$(id)/members/$(uid));

          // The owner marks a pending request as accepted (declining deletes it)
          allow update: if request.auth != null
            && teamDoc(id, tid).ownerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && resource.data.status == 'pending'
            && request.resource.data.status == 'accepted';

          allow delete: if request.auth != null
            && (request.auth.uid == uid || teamDoc(id, tid).ownerUid == request.auth.uid || isAdmin());
        }

        // Team chat: members only, one message per member every 2 minutes
        match /limits/{uid} {
          allow read: if request.auth != null && request.auth.uid == uid;

          allow create: if request.auth != null
            && request.auth.uid == uid
            && uid in teamDoc(id, tid).memberIds
            && request.resource.data.keys().hasOnly(['last'])
            && request.resource.data.last == request.time;

          allow update: if request.auth != null
            && request.auth.uid == uid
            && uid in teamDoc(id, tid).memberIds
            && request.resource.data.keys().hasOnly(['last'])
            && request.resource.data.last == request.time
            && request.time > resource.data.last + duration.value(2, 'm');
        }

        match /messages/{mid} {
          allow read: if request.auth != null
            && (request.auth.uid in teamDoc(id, tid).memberIds || isAdmin());

          allow create: if request.auth != null
            && request.auth.uid in teamDoc(id, tid).memberIds
            && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.name == me().fullName
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 1000
            && request.resource.data.createdAt == request.time
            && getAfter(/databases/$(database)/documents/competitions/$(id)/teams/$(tid)/limits/$(request.auth.uid)).data.last == request.time;

          allow update: if false;

          // Delete: your own message, the team owner, an admin, or any message from a previous day
          // (the first member who opens the chat after midnight cleans up; rules compare against the UTC day)
          allow delete: if request.auth != null
            && (
              resource.data.uid == request.auth.uid
              || teamDoc(id, tid).ownerUid == request.auth.uid
              || isAdmin()
              || (request.auth.uid in teamDoc(id, tid).memberIds
                  && resource.data.createdAt.toMillis() < request.time.toMillis() - (request.time.toMillis() % 86400000))
            );
        }
      }
    }

    // ---------- Q&A ----------
    // One posting limit per student, shared by questions and answers: one post every 30 seconds.
    // Each question or answer is written in the same batch as this document, and the rules
    // below check that the batch really updated it.
    match /qaLimits/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time
        && request.time > resource.data.last + duration.value(30, 's');
    }

    // Questions are open to every signed-in student, from any school.
    match /questions/{qid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'school', 'text', 'image', 'link', 'answerCount', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == me().fullName
        && request.resource.data.school == me().school
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 1000
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 300000
        && validLink(request.resource.data.link)
        && request.resource.data.answerCount == 0
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/qaLimits/$(request.auth.uid)).data.last == request.time;

      // After creation the only thing that changes is the answer counter, and only by one,
      // in the same batch as the answer that justifies it.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answerCount'])
        && request.resource.data.answerCount is int
        && (
          // someone posted their answer
          (request.resource.data.answerCount == resource.data.answerCount + 1
            && !exists(/databases/$(database)/documents/questions/$(qid)/answers/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/questions/$(qid)/answers/$(request.auth.uid)))
          // an answer was deleted: by its author, by the question's owner, or by an admin
          || (request.resource.data.answerCount == resource.data.answerCount - 1
            && request.resource.data.answerCount >= 0
            && (
              (exists(/databases/$(database)/documents/questions/$(qid)/answers/$(request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/questions/$(qid)/answers/$(request.auth.uid)))
              || resource.data.uid == request.auth.uid
              || isAdmin()))
        );

      // The owner or an admin removes a question (the app deletes its answers first)
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());

      // The document id is the author's uid: a student can create only one answer per question.
      match /answers/{uid} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'school', 'text', 'image', 'link', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name == me().fullName
          && request.resource.data.school == me().school
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 300000
          && validLink(request.resource.data.link)
          && (request.resource.data.text.size() > 0
              || request.resource.data.image.size() > 0
              || request.resource.data.link.size() > 0)
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/questions/$(qid)).data.answerCount
              == get(/databases/$(database)/documents/questions/$(qid)).data.answerCount + 1
          && getAfter(/databases/$(database)/documents/qaLimits/$(request.auth.uid)).data.last == request.time;

        // Answers are never edited
        allow update: if false;

        // Delete: your own answer, the question's owner, or an admin
        allow delete: if request.auth != null
          && (request.auth.uid == uid
              || isAdmin()
              || get(/databases/$(database)/documents/questions/$(qid)).data.uid == request.auth.uid);
      }
    }

    // ---------- study: YouTube channels and Drive documents (posted by admins, read by everyone signed in) ----------
    function validSubject(s) {
      return s in ['social', 'physics', 'chemistry', 'biology', 'geology', 'arabic', 'math', 'mechanics'];
    }
    function validStudyLink(l) {
      return l is string && l.size() <= 300 && l.matches('https?://.+');
    }

    match /studyChannels/{id} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['subject', 'name', 'link', 'profile', 'cover', 'createdAt'])
        && request.resource.data.keys().hasAll(['subject', 'name', 'link', 'profile', 'cover', 'createdAt'])
        && validSubject(request.resource.data.subject)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100
        && validStudyLink(request.resource.data.link)
        && request.resource.data.profile is string
        && request.resource.data.profile.size() <= 60000
        && request.resource.data.cover is string
        && request.resource.data.cover.size() <= 150000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /studyDocs/{id} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['subject', 'name', 'link', 'createdAt'])
        && request.resource.data.keys().hasAll(['subject', 'name', 'link', 'createdAt'])
        && validSubject(request.resource.data.subject)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100
        && validStudyLink(request.resource.data.link)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Everything else stays closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
